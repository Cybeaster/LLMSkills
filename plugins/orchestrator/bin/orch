import { parseArgs } from "node:util";

// src/errors.ts
var OrchError = class extends Error {
  constructor(message, code = 1) {
    super(message);
    this.code = code;
  }
  name = "OrchError";
};

// src/evidence.ts
var KINDS = ["commit", "pr", "ci", "cmd", "note"];
var isKind = (k) => KINDS.includes(k);
var USAGE = "use commit:<sha> | pr:<number|url> | ci:<run-url> | cmd:<command> | note:<text>";
var SHA = /^[0-9a-f]{4,64}$/i;
function parseEvidence(s) {
  const i = s.indexOf(":");
  const kind2 = s.slice(0, i);
  const ref = s.slice(i + 1).trim();
  if (i < 1 || !isKind(kind2) || !ref) throw new OrchError(`bad evidence "${s}": ${USAGE}`, 2);
  if (kind2 === "commit" && !SHA.test(ref)) {
    throw new OrchError(`bad evidence "${s}": commit needs a sha, e.g. commit:$(git rev-parse --short HEAD)`, 2);
  }
  if ((kind2 === "pr" || kind2 === "ci") && ref.startsWith("-")) {
    throw new OrchError(`bad evidence "${s}": a ${kind2} ref cannot start with "-"`, 2);
  }
  return { kind: kind2, ref };
}
function grade(ev, check) {
  if (!ev || ev.kind === "note") return "claimed";
  if (ev.kind === "commit") return "proven";
  if (ev.kind === "cmd") return ev.exit === 0 ? "proven" : "contradicted";
  if (check === "pass") return "proven";
  if (check === "fail") return "contradicted";
  return "unverified";
}
var oneLine = (s) => String(s ?? "").replace(new RegExp("\\p{Cf}", "gu"), "").replace(/[\s\p{Cc}]+/gu, " ").trim();
var stripEscapes = (s) => s.replace(/\x1b\[[0-?]*[ -/]*[@-~]/g, "").replace(/\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)/g, "");
var safeLine = (s) => oneLine(stripEscapes(String(s ?? "")));
function describeEvidence(ev) {
  const ref = oneLine(ev.ref);
  switch (ev.kind) {
    case "commit":
      return `commit ${ref.slice(0, 7)}`;
    case "cmd":
      return `cmd ${ref} (exit ${String(ev.exit)})`;
    case "note":
      return `note: ${ref}`;
    default:
      return `${ev.kind} ${ref}`;
  }
}
var checkKey = (ev, cwd) => `${cwd}\0${ev.kind}:${ev.ref}`;

// src/width.ts
var graphemes = new Intl.Segmenter(void 0, { granularity: "grapheme" });
var INVISIBLE = /^[\p{Mn}\p{Me}\p{Cf}]+$/u;
var EMOJI = new RegExp("\\p{Emoji_Presentation}", "u");
var WIDE = [
  [4352, 4447],
  [11904, 42191],
  [44032, 55203],
  [63744, 64255],
  [65072, 65103],
  [65280, 65376],
  [65504, 65510],
  [131072, 262141]
];
function graphemeWidth(g) {
  if (INVISIBLE.test(g)) return 0;
  if (EMOJI.test(g) || g.includes("\uFE0F")) return 2;
  const cp = g.codePointAt(0);
  return WIDE.some(([lo, hi]) => cp >= lo && cp <= hi) ? 2 : 1;
}
function width(s) {
  let n = 0;
  for (const { segment } of graphemes.segment(s)) n += graphemeWidth(segment);
  return n;
}
function clip(s, n) {
  if (width(s) <= n) return s;
  let out = "";
  let used = 0;
  for (const { segment } of graphemes.segment(s)) {
    const w = graphemeWidth(segment);
    if (used + w > n - 1) break;
    out += segment;
    used += w;
  }
  return `${out}\u2026`;
}
function pad(s, n) {
  const c = clip(s, n);
  return c + " ".repeat(Math.max(0, n - width(c)));
}

// src/sources/sessions.ts
import { readdirSync, readFileSync } from "node:fs";
import { join } from "node:path";
function startTimeOf(pid) {
  try {
    const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
    return stat.slice(stat.lastIndexOf(")") + 2).split(" ")[19];
  } catch {
    return void 0;
  }
}
function pidAlive(pid, procStart) {
  if (!Number.isInteger(pid) || pid <= 1) return false;
  try {
    process.kill(pid, 0);
  } catch {
    return false;
  }
  if (procStart === void 0) return true;
  const now = startTimeOf(pid);
  return now === void 0 || now === procStart;
}
function readLiveSessions(claudeHome, isAlive = pidAlive) {
  const dir = join(claudeHome, "sessions");
  let names;
  try {
    names = readdirSync(dir);
  } catch {
    return [];
  }
  const out = [];
  for (const n of names) {
    if (!/^\d+\.json$/.test(n)) continue;
    try {
      const o = JSON.parse(readFileSync(join(dir, n), "utf8"));
      if (o.spare === true || typeof o.parkedJobId === "string") continue;
      if (typeof o.sessionId !== "string" || typeof o.pid !== "number") continue;
      if (!isAlive(o.pid, typeof o.procStart === "string" ? o.procStart : void 0)) continue;
      out.push({
        pid: o.pid,
        sessionId: o.sessionId,
        cwd: typeof o.cwd === "string" ? o.cwd : "",
        name: typeof o.name === "string" ? o.name : void 0,
        status: o.status === "busy" ? "busy" : "idle",
        // a blank or unprintable reason still means the session is waiting, so it falls back to 'input'
        waitingFor: o.status === "waiting" ? oneLine(typeof o.waitingFor === "string" ? o.waitingFor : "") || "input" : void 0,
        bridgeSessionId: typeof o.bridgeSessionId === "string" ? o.bridgeSessionId : void 0
      });
    } catch {
    }
  }
  return out;
}
function sessionLink(s) {
  const id = s?.bridgeSessionId?.replace(/^cse_/, "session_");
  return id && /^[A-Za-z0-9_-]+$/.test(id) ? `https://claude.ai/code/${id}` : void 0;
}

// src/overview.ts
var DAY = 24 * 60 * 60 * 1e3;
function viewTask(t, cwd, checks, childDone) {
  const kids = t.children ?? [];
  const kidsDone = kids.filter(childDone).length;
  let status = t.status;
  if (kids.length) status = kidsDone === kids.length ? "done" : t.status === "done" ? "in_progress" : t.status;
  let mark;
  let detail = kids.length ? `${kids.length} children: ${kidsDone} \u2713 ${kids.length - kidsDone} running` : "";
  if (t.needsInput) {
    mark = "\u2691";
    detail = `"${oneLine(t.needsInput)}"`;
  } else if (status === "done" && kids.length && !t.evidence) {
    mark = "\u2713";
  } else if (status === "done") {
    const g = grade(t.evidence, t.evidence ? checks.get(checkKey(t.evidence, cwd)) : void 0);
    mark = g === "proven" ? "\u2713" : g === "claimed" ? "~" : g === "contradicted" ? "\u2717" : "?";
    detail = t.evidence ? clip(describeEvidence(t.evidence), 40) : "claimed, no evidence";
    if (g === "contradicted") detail += " \u2717 failing (live)";
    if (g === "unverified") detail += " (unverified)";
  } else if (status === "in_progress") {
    mark = "\u25D0";
  } else if (status === "blocked") {
    mark = "!";
    detail = oneLine(t.blockedReason) || "blocked";
  } else {
    mark = "\xB7";
  }
  return { id: t.id, text: oneLine(t.text), status, mark, detail };
}
var byName = (a, b) => a.name.localeCompare(b.name, void 0, { numeric: true });
var byPriority = (a, b) => b.flags - a.flags || Number(a.state === "ended") - Number(b.state === "ended") || byName(a, b);
function buildOverview(input) {
  const pools = new Map(input.pools.map((e) => [e.id, e]));
  const live2 = new Map(input.live.map((s) => [s.sessionId, s]));
  const agents = new Map((input.agents ?? []).filter((a) => a.sessionId).map((a) => [a.sessionId, a]));
  const parentOf = (id) => pools.get(id)?.pool?.parent?.sessionId;
  const ids = new Set(live2.keys());
  const parents = new Set(input.pools.map((e) => e.pool?.parent?.sessionId));
  const blank = (id) => {
    const p = pools.get(id)?.pool;
    return !live2.has(id) && !!p && !p.tasks.length && !p.title && !p.parent && !p.brief && !parents.has(id);
  };
  for (const [id, e] of pools) if (e.error || e.pool && input.now - e.pool.updatedAt < DAY && !blank(id)) ids.add(id);
  for (let grew = true; grew; ) {
    grew = false;
    for (const id of pools.keys()) {
      const parent = parentOf(id);
      if (!parent) continue;
      if (!ids.has(id) && live2.has(parent)) {
        ids.add(id);
        grew = true;
      }
      if (ids.has(id) && pools.has(parent) && !ids.has(parent)) {
        ids.add(parent);
        grew = true;
      }
    }
  }
  const built = /* @__PURE__ */ new Map();
  const memo = /* @__PURE__ */ new Map();
  const completeWalk = (id, visiting) => {
    const known = memo.get(id);
    if (known !== void 0) return known;
    const tasks = pools.get(id)?.pool?.tasks;
    if (!tasks?.length || visiting.has(id)) return false;
    visiting.add(id);
    const ok2 = tasks.every((t) => t.children?.length ? t.children.every((c) => completeWalk(c, visiting)) : t.status === "done");
    visiting.delete(id);
    memo.set(id, ok2);
    return ok2;
  };
  const isComplete = (id) => completeWalk(id, /* @__PURE__ */ new Set());
  const build = (id, path) => {
    const inner = new Set(path).add(id);
    const children = [...ids].filter((c) => parentOf(c) === id && !inner.has(c)).map((c) => build(c, inner)).sort(byName);
    const e = pools.get(id);
    const pool = e?.pool;
    const s = live2.get(id);
    const a = agents.get(id);
    const tasks = (pool?.tasks ?? []).map((t) => viewTask(t, pool?.cwd ?? "", input.checks, isComplete));
    const done = tasks.filter((t) => t.status === "done").length;
    const parent = pool?.parent?.sessionId;
    const row = {
      sessionId: id,
      name: oneLine(a?.name) || oneLine(s?.name) || oneLine(pool?.title) || oneLine(id.slice(0, 8)),
      title: oneLine(pool?.title) || oneLine(a?.title),
      // a path may hold spaces, so control characters are replaced rather than folded away by oneLine
      cwd: (pool?.cwd || s?.cwd || "").replace(/[\p{Cc}\p{Cf}]/gu, "?"),
      state: s ? s.waitingFor ? "waiting" : s.status : "ended",
      waitingFor: s?.waitingFor ? oneLine(s.waitingFor) : void 0,
      tag: s ? a ? "herdr" : "external" : "\u2014",
      paneId: a?.paneId,
      link: sessionLink(s),
      pid: s?.pid,
      hasPool: tasks.length > 0,
      unreadable: e?.error === void 0 ? void 0 : oneLine(e.error),
      orphan: !!parent && !pools.has(parent) && !live2.has(parent),
      done,
      total: tasks.length,
      complete: isComplete(id),
      touchedAt: pool?.touchedAt ?? pool?.updatedAt ?? 0,
      flags: (pool?.tasks.filter((t) => t.needsInput).length ?? 0) + children.reduce((n, c) => n + c.flags, 0),
      tasks,
      children
    };
    built.set(id, row);
    return row;
  };
  const top = [...ids].filter((id) => {
    const p = parentOf(id);
    return !p || !ids.has(p);
  });
  const rows = top.map((id) => build(id, /* @__PURE__ */ new Set()));
  for (const id of ids) {
    if (built.has(id)) continue;
    let root = id;
    for (const seen = /* @__PURE__ */ new Set(); !seen.has(root); root = parentOf(root) ?? root) seen.add(root);
    rows.push(build(root, /* @__PURE__ */ new Set()));
  }
  return rows.sort(byPriority);
}

// src/store.ts
import {
  appendFileSync,
  closeSync,
  fsyncSync,
  mkdirSync,
  openSync,
  readdirSync as readdirSync2,
  readFileSync as readFileSync2,
  renameSync,
  rmSync,
  statSync,
  writeFileSync
} from "node:fs";
import { join as join2 } from "node:path";
var ID_PATTERN = /^[A-Za-z0-9][A-Za-z0-9_-]*$/;
function poolPath(home, id) {
  if (!ID_PATTERN.test(id)) throw new OrchError(`invalid session id "${id}"`);
  return join2(home, `${id}.json`);
}
var TASK_ID = /^[A-Za-z0-9_-]+$/;
var STATUSES = ["pending", "in_progress", "done", "blocked"];
function isTask(v) {
  const t = v;
  return typeof t === "object" && t !== null && typeof t.id === "string" && TASK_ID.test(t.id) && typeof t.text === "string" && STATUSES.includes(t.status) && (t.children === void 0 || Array.isArray(t.children) && t.children.every((c) => typeof c === "string"));
}
function isPool(v) {
  const p = v;
  return typeof p?.sessionId === "string" && typeof p.cwd === "string" && Array.isArray(p.tasks) && p.tasks.every(isTask);
}
function parsePool(path, id, text) {
  let v;
  try {
    v = JSON.parse(text);
  } catch (e) {
    throw new OrchError(`pool file ${path} is not valid JSON (${e.message}); fix or delete it`);
  }
  if (!isPool(v)) throw new OrchError(`pool file ${path} is not a pool; fix or delete it`);
  if (v.sessionId !== id) throw new OrchError(`pool file ${path} holds session ${v.sessionId}; fix or delete it`);
  return v;
}
function readPool(home, id) {
  const path = poolPath(home, id);
  let text;
  try {
    text = readFileSync2(path, "utf8");
  } catch (e) {
    if (e.code === "ENOENT") return void 0;
    throw e;
  }
  return parsePool(path, id, text);
}
function writePool(home, pool) {
  const path = poolPath(home, pool.sessionId);
  mkdirSync(home, { recursive: true });
  const tmp = `${path}.${process.pid}.${Math.random().toString(36).slice(2)}.tmp`;
  try {
    const fd = openSync(tmp, "w");
    try {
      writeFileSync(fd, JSON.stringify(pool, null, 2));
      fsyncSync(fd);
    } finally {
      closeSync(fd);
    }
    renameSync(tmp, path);
  } catch (e) {
    try {
      rmSync(tmp, { force: true });
    } catch {
    }
    throw e;
  }
}
function listPools(home) {
  let names;
  try {
    names = readdirSync2(home);
  } catch {
    return [];
  }
  return names.filter((n) => n.endsWith(".json") && ID_PATTERN.test(n.slice(0, -".json".length))).map((n) => {
    const id = n.slice(0, -".json".length);
    const path = join2(home, n);
    try {
      return { id, pool: parsePool(path, id, readFileSync2(path, "utf8")) };
    } catch (e) {
      return { id, error: e instanceof Error ? e.message : String(e) };
    }
  });
}
var sleep = (ms) => new Promise((r) => setTimeout(r, ms));
var lockTiming = { staleMs: 5e3, deadlineMs: 7e3 };
async function withLock(home, id, fn, waitMs = lockTiming.deadlineMs) {
  const lock = `${poolPath(home, id)}.lock`;
  mkdirSync(home, { recursive: true });
  const deadline = Date.now() + waitMs;
  for (; ; ) {
    let held = 0;
    try {
      mkdirSync(lock);
      break;
    } catch (e) {
      if (e.code !== "EEXIST") throw e;
      try {
        held = Date.now() - statSync(lock).mtimeMs;
        if (held > lockTiming.staleMs) {
          rmSync(lock, { recursive: true, force: true });
          continue;
        }
      } catch (err) {
        if (err.code === "ENOENT") continue;
        throw new OrchError(`cannot break stale lock ${lock}: ${err.message}`);
      }
      if (Date.now() > deadline) {
        throw new OrchError(
          `pool ${id} is locked (${lock}, held ${Math.round(held)} ms); if no orch is running, delete that directory`
        );
      }
      await sleep(10 + Math.random() * 20);
    }
  }
  try {
    return fn();
  } finally {
    rmSync(lock, { recursive: true, force: true });
  }
}
function writeUnder(home, id, next) {
  if (next.sessionId !== id) {
    throw new OrchError(`refusing to write pool ${next.sessionId} under session ${id}`);
  }
  writePool(home, next);
  return next;
}
function update(home, id, fn, waitMs) {
  return withLock(home, id, () => writeUnder(home, id, fn(readPool(home, id))), waitMs);
}
function updateIfExists(home, id, fn, waitMs) {
  return withLock(
    home,
    id,
    () => {
      const cur = readPool(home, id);
      if (!cur) return void 0;
      return writeUnder(home, id, fn(cur));
    },
    waitMs
  );
}
var LOG_MAX_BYTES = 1024 * 1024;
function log(home, message) {
  try {
    mkdirSync(home, { recursive: true });
    const file = join2(home, "orch.log");
    try {
      if (statSync(file).size > LOG_MAX_BYTES) renameSync(file, `${file}.1`);
    } catch {
    }
    appendFileSync(file, `${(/* @__PURE__ */ new Date()).toISOString()} ${message}
`);
  } catch {
  }
}

// src/collect.ts
async function collect(ctx, opts = {}) {
  const which = opts.checks ?? "none";
  const pools = listPools(ctx.orchHome);
  const live2 = readLiveSessions(ctx.claudeHome, ctx.isAlive);
  const liveIds = new Set(live2.map((s) => s.sessionId));
  const wanted = (id) => which === "none" ? false : which === "live" ? liveIds.has(id) : which.has(id);
  const checks = /* @__PURE__ */ new Map();
  const [agents] = await Promise.all([
    (async () => ctx.herdr.list())().catch(() => null),
    ...pools.filter((e) => wanted(e.id)).flatMap(
      (e) => (e.pool?.tasks ?? []).filter((t) => t.status === "done" && (t.evidence?.kind === "ci" || t.evidence?.kind === "pr")).map(async (t) => checks.set(checkKey(t.evidence, e.pool.cwd ?? ""), await ctx.gh.check(t.evidence, e.pool.cwd, { stale: opts.stale })))
    )
  ]);
  return buildOverview({ pools, live: live2, agents, checks, now: ctx.now() });
}

// src/ctx.ts
import { spawn } from "node:child_process";
import { existsSync as existsSync2, readFileSync as readFileSync3 } from "node:fs";
