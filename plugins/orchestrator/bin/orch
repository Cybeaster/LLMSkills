// src/sources/gh.ts
import { execFile } from "node:child_process";
import { existsSync } from "node:fs";
import { tmpdir } from "node:os";
var runGh = (args, cwd) => new Promise((resolve2) => {
  execFile("gh", args, { cwd, timeout: 2e4 }, (err, stdout) => resolve2({ code: err ? 1 : 0, stdout: String(stdout) }));
});
var FAILED = ["FAILURE", "ERROR", "CANCELLED", "TIMED_OUT", "ACTION_REQUIRED", "STARTUP_FAILURE"];
var PASSED = ["SUCCESS", "NEUTRAL", "SKIPPED"];
var MAX_GH = 4;
var ANSWER_TTL_MS = 6e4;
var UNKNOWN_TTL_MS = 15e3;
async function ciCheck(run2, ref, cwd) {
  const m = ref.match(/github\.com\/([^/]+\/[^/]+)\/actions\/runs\/(\d+)/);
  const args = m ? ["run", "view", "-R", m[1], "--json", "status,conclusion", "--", m[2]] : ["run", "view", "--json", "status,conclusion", "--", ref];
  const r = await run2(args, cwd);
  if (r.code !== 0) return { value: "unknown", final: false };
  const o = JSON.parse(r.stdout);
  if (o.status !== "completed") return { value: "pending", final: false };
  const c = String(o.conclusion ?? "").toUpperCase();
  return PASSED.includes(c) ? { value: "pass", final: true } : FAILED.includes(c) ? { value: "fail", final: false } : { value: "unknown", final: false };
}
async function prCheck(run2, ref, cwd) {
  const r = await run2(["pr", "view", "--json", "state,statusCheckRollup", "--", ref], cwd);
  if (r.code !== 0) return { value: "unknown", final: false };
  const o = JSON.parse(r.stdout);
  if (o.state === "MERGED") return { value: "pass", final: true };
  if (o.state === "CLOSED") return { value: "fail", final: true };
  const states = (o.statusCheckRollup ?? []).map((c) => c.conclusion || c.state || "");
  if (states.some((s) => FAILED.includes(s))) return { value: "fail", final: false };
  if (states.length && states.every((s) => PASSED.includes(s))) return { value: "pass", final: false };
  return { value: "pending", final: false };
}
function runDir(ref, cwd) {
  if (cwd && existsSync(cwd)) return cwd;
  return /^https?:\/\//i.test(ref) ? tmpdir() : void 0;
}
async function ask(run2, ev, cwd) {
  const dir = runDir(ev.ref, cwd);
  if (dir === void 0) return { value: "unknown", final: false };
  return ev.kind === "ci" ? ciCheck(run2, ev.ref, dir) : prCheck(run2, ev.ref, dir);
}
function cliGh(run2 = runGh, now = Date.now) {
  let active = 0;
  const waiting = [];
  const limited = async (args, cwd) => {
    if (active >= MAX_GH) await new Promise((go) => waiting.push(go));
    active++;
    try {
      return await run2(args, cwd);
    } finally {
      active--;
      waiting.shift()?.();
    }
  };
  const cache = /* @__PURE__ */ new Map();
  const refresh = (e, ev, cwd) => e.inflight ??= ask(limited, ev, cwd).catch(() => ({ value: "unknown", final: false })).then((a) => {
    e.value = a.value;
    e.final = a.final;
    e.arrivedAt = now();
    e.inflight = void 0;
  });
  return {
    async check(ev, cwd, opts = {}) {
      if (ev.kind !== "ci" && ev.kind !== "pr") return "unknown";
      const key = checkKey(ev, cwd);
      let e = cache.get(key);
      if (!e) cache.set(key, e = {});
      const fresh = e.value !== void 0 && (e.final || now() - e.arrivedAt < (e.value === "unknown" ? UNKNOWN_TTL_MS : ANSWER_TTL_MS));
      if (fresh) return e.value;
      const refreshing = refresh(e, ev, cwd);
      if (opts.stale) return e.value ?? "unknown";
      await refreshing;
      return e.value;
    }
  };
}

// src/sources/herdr.ts
import { execFile as execFile2 } from "node:child_process";
var HerdrError = class extends OrchError {
  constructor(message, herdrCode) {
    super(message);
    this.herdrCode = herdrCode;
  }
  name = "HerdrError";
};
var DEFAULT_TIMEOUT_MS = 1e4;
var START_TIMEOUT_MS = 75e3;
var WAIT_SLACK_MS = 1e4;
var runHerdr = (args, timeoutMs) => {
  const limit = timeoutMs ?? DEFAULT_TIMEOUT_MS;
  return new Promise((resolve2) => {
    execFile2("herdr", args, { timeout: limit, maxBuffer: 16 << 20 }, (err, stdout, stderr) => {
      const timedOut = err?.killed === true && typeof err.code !== "string";
      const code = err ? typeof err.code === "number" ? err.code : 127 : 0;
      const error = err ? timedOut ? `timed out after ${limit}ms` : err.message : void 0;
      resolve2({ code, stdout: String(stdout), stderr: String(stderr), error, timedOut });
    });
  });
};
var isObj = (v) => typeof v === "object" && v !== null && !Array.isArray(v);
var str = (v) => typeof v === "string" ? v : void 0;
var agentIn = (reply2) => isObj(reply2) && isObj(reply2.result) && isObj(reply2.result.agent) ? reply2.result.agent : void 0;
var snippet = (v) => JSON.stringify(v).slice(0, 200);
var sessionIdIn = (s) => isObj(s) && s.kind === "id" && typeof s.value === "string" && s.value ? s.value : void 0;
function herdrErrorIn(text) {
  try {
    const e = JSON.parse(text)?.error;
    if (isObj(e) && (typeof e.code === "string" || typeof e.message === "string")) return { code: str(e.code), message: str(e.message) };
  } catch {
  }
  return void 0;
}
function failure(args, r) {
  const what = `herdr ${args.slice(0, 2).join(" ")} failed`;
  const e = herdrErrorIn(r.stderr) ?? herdrErrorIn(r.stdout);
  if (e) return new HerdrError(`${what}: ${e.message ?? e.code}${e.message && e.code ? ` (${e.code})` : ""}`, e.code);
  return new HerdrError(`${what}: ${r.stderr.trim() || r.stdout.trim() || (r.error ?? "").trim()}`, r.timedOut ? "timeout" : void 0);
}
function cliHerdr(run2 = runHerdr) {
  const ok2 = async (args, timeoutMs) => {
    const r = await run2(args, timeoutMs);
    if (r.code !== 0) throw failure(args, r);
    return r.stdout;
  };
  const json = async (args, timeoutMs) => {
    const out = await ok2(args, timeoutMs);
    try {
      return JSON.parse(out);
    } catch {
      throw new HerdrError(`herdr ${args.slice(0, 2).join(" ")} did not answer with JSON: ${out.trim().slice(0, 200)}`);
    }
  };
  return {
    async list() {
      const o = await json(["agent", "list"]);
      const agents = isObj(o) && isObj(o.result) ? o.result.agents : void 0;
      if (!Array.isArray(agents)) throw new HerdrError(`unexpected herdr agent list reply: ${snippet(o)}`);
      return agents.filter((a) => isObj(a) && a.agent === "claude" && typeof a.pane_id === "string").map((a) => ({
        name: str(a.name),
        paneId: a.pane_id,
        status: str(a.agent_status) ?? "unknown",
        sessionId: sessionIdIn(a.agent_session),
        title: str(a.terminal_title_stripped)
      }));
    },
    async focus(target) {
      await ok2(["agent", "focus", target]);
    },
    async createTab({ workspace, cwd, label }) {
      const o = await json(["tab", "create", "--workspace", workspace, "--cwd", cwd, "--label", label, "--no-focus"]);
      const root = isObj(o) && isObj(o.result) ? o.result.root_pane : void 0;
      const paneId = isObj(root) ? str(root.pane_id) : void 0;
      if (!paneId) throw new HerdrError(`unexpected herdr tab create reply: ${snippet(o)}`);
      return { paneId };
    },
    async startClaude({ name, paneId, args }) {
      await ok2(["agent", "start", name, "--kind", "claude", "--pane", paneId, "--timeout", "60000", "--", ...args], START_TIMEOUT_MS);
    },
    async sessionIdOf(name) {
      try {
        return sessionIdIn(agentIn(await json(["agent", "get", name]))?.agent_session);
      } catch {
        return void 0;
      }
    },
    async waitIdle(target, timeoutMs) {
      await ok2(["agent", "wait", target, "--until", "idle", "--until", "done", "--until", "blocked", "--timeout", String(timeoutMs)], timeoutMs + WAIT_SLACK_MS);
      const o = await json(["agent", "get", target]);
      const status = str(agentIn(o)?.agent_status);
      if (!status) throw new HerdrError(`unexpected herdr agent get reply: ${snippet(o)}`);
      return status;
    },
    async prompt(target, text) {
      await ok2(["agent", "prompt", target, text]);
    }
  };
}

// src/ctx.ts
var CMD_TIMEOUT_MS = 11e4;
var OUT_KEEP = 64 * 1024;
function ppidOf(pid) {
  try {
    const stat = readFileSync3(`/proc/${pid}/stat`, "utf8");
    const ppid = Number(stat.slice(stat.lastIndexOf(")") + 2).split(" ")[1]);
    return Number.isFinite(ppid) ? ppid : void 0;
  } catch {
    return void 0;
  }
}
var FORWARDED = ["SIGINT", "SIGTERM", "SIGHUP", "SIGQUIT"];
function execShell(command, cwd, opts = {}) {
  const { timeoutMs = CMD_TIMEOUT_MS, graceMs = 2e3, closeWaitMs = 1e3 } = opts;
  if (!existsSync2(cwd)) return Promise.resolve({ code: 127, out: `directory ${cwd} does not exist` });
  return new Promise((resolve2) => {
    let out = "";
    let pid;
    let timedOut = false;
    let terminating = false;
    let settled = false;
    let killTimer;
    const killGroup = (sig) => {
      try {
        if (pid) process.kill(-pid, sig);
      } catch {
      }
    };
    const terminate = () => {
      if (terminating) return killGroup("SIGKILL");
      terminating = true;
      killGroup("SIGTERM");
      killTimer = setTimeout(() => killGroup("SIGKILL"), graceMs);
    };
    const deadline = setTimeout(() => {
      timedOut = true;
      terminate();
    }, timeoutMs);
    const settle = (r) => {
      if (settled) return;
      settled = true;
      clearTimeout(deadline);
      clearTimeout(killTimer);
      for (const sig of FORWARDED) process.off(sig, terminate);
      killGroup("SIGKILL");
      resolve2({ ...r, out, ...timedOut ? { timedOut } : {} });
    };
    for (const sig of FORWARDED) process.on(sig, terminate);
    let child;
    try {
      child = spawn("bash", ["-c", command], { cwd, detached: true, stdio: ["ignore", "pipe", "pipe"] });
    } catch (e) {
      out = String(e);
      return settle({ code: 127, out });
    }
    pid = child.pid;
    child.stdout.setEncoding("utf8");
    child.stderr.setEncoding("utf8");
    const keep = (d) => out = (out + d).slice(-OUT_KEEP);
    child.stdout.on("data", keep);
    child.stderr.on("data", keep);
    child.on("error", (e) => {
      out = String(e);
      settle({ code: 127, out });
    });
    let exited;
    child.on("exit", (code, signal) => {
      clearTimeout(deadline);
      exited = { code: code ?? 1, out, ...signal ? { signal } : {} };
      setTimeout(() => settle(exited), closeWaitMs).unref();
    });
    child.on("close", () => exited && settle(exited));
  });
}
async function readStdin() {
  let s = "";
  for await (const chunk of process.stdin) s += chunk;
  return s;
}
function realCtx(env = process.env) {
  const claudeHome = env.ORCH_CLAUDE_HOME || env.CLAUDE_CONFIG_DIR || join3(homedir(), ".claude");
  return {
    env,
    claudeHome,
    orchHome: env.ORCH_HOME || join3(claudeHome, "orchestrator"),
    cwd: process.cwd(),
    pid: process.pid,
    now: Date.now,
    sleep: (ms) => new Promise((r) => setTimeout(r, ms)),
    ppidOf,
    isAlive: pidAlive,
    readStdin,
    exec: (command, cwd) => execShell(command, cwd),
    herdr: cliHerdr(),
    gh: cliGh()
  };
}

// src/format.ts
import { homedir as homedir2 } from "node:os";
function flatten(rows) {
  const out = [];
  const walk = (rs, indent, nested) => rs.forEach((r, i) => {
    const last = i === rs.length - 1;
    out.push({ row: r, prefix: nested ? `${indent}${last ? "\u2514 " : "\u251C "}` : "" });
    walk(r.children, nested ? `${indent}${last ? "  " : "\u2502 "}` : "", true);
  });
  walk(rows, "", false);
  return out;
}
function shortCwd(cwd, home = homedir2()) {
  const src = `${home}/src/`;
  const short = cwd === home ? "~" : cwd.startsWith(src) ? cwd.slice(src.length) : cwd.startsWith(`${home}/`) ? `~${cwd.slice(home.length)}` : cwd;
  return short.replace("/.worktrees/", "/wt/");
}
function listLine({ row, prefix }) {
  const progress = row.unreadable ? "unreadable pool" : row.hasPool ? `${row.done}/${row.total}${row.complete ? " \u2713" : ""}` : "\u2014  no pool";
  const flags = row.flags ? `  \u2691${row.flags}` : "";
  const orphan = row.orphan ? "  orphan" : "";
  return `${pad(prefix + row.name, 24)} ${pad(shortCwd(row.cwd), 22)} ${pad(row.state, 7)} ${pad(row.tag, 9)} ${progress}${flags}${orphan}`;
}
function header(rows) {
  const all = flatten(rows).map((l) => l.row);
  const live2 = all.filter((r) => r.state !== "ended").length;
  const flags = rows.reduce((n, r) => n + r.flags, 0);
  return `ORCHESTRATOR  ${live2} live \xB7 ${flags} \u2691 \xB7 ${all.length - live2} ended`;
}
function renderList(rows) {
  const lines = flatten(rows).map((l) => {
    const link = l.row.link ? `
${" ".repeat(l.prefix.length + 2)}\u2192 ${l.row.link}` : "";
    return listLine(l) + link;
  });
  return [header(rows), ...lines].join("\n") + "\n";
}
function poolLines(row) {
  const head = row.title && row.title !== row.name ? `${row.name} \u2014 ${row.title}` : row.name;
  if (row.unreadable) return [head, `unreadable pool: ${row.unreadable}`];
  if (!row.tasks.length) return [head, "(no pool yet)"];
  return [head, ...row.tasks.map((t) => `${t.mark} ${t.id.padEnd(4)} ${pad(t.text, 34)} ${t.detail}`.trimEnd())];
}
var renderPool = (row) => poolLines(row).join("\n") + "\n";

// src/hooks.ts
import { appendFileSync as appendFileSync2, closeSync as closeSync2, fstatSync, openSync as openSync2, readSync } from "node:fs";

// src/frame.ts
var frameQuestion = (question) => `[orch reply to: ${JSON.stringify(Array.from(oneLine(question)).slice(0, 200).join(""))}]`;
var FRAME = /\[orch reply to: "(?:[^"\\]|\\.)*"\]/;
var findFrame = (prompt) => FRAME.exec(prompt)?.[0];

// src/model.ts
function newPool(sessionId, cwd, now) {
  return { sessionId, title: "", cwd, tasks: [], seq: 0, createdAt: now, updatedAt: now };
}
var clone = (p) => structuredClone(p);
function find(p, id) {
  const t = p.tasks.find((t2) => t2.id === id);
  if (!t) throw new OrchError(`no task ${id} in this pool (have: ${p.tasks.map((t2) => t2.id).join(", ") || "none"})`);
  return t;
}
function nextId(p) {
  p.seq = Math.max(p.seq ?? 0, ...p.tasks.map((t) => Number(t.id.slice(1)) || 0)) + 1;
  return `t${p.seq}`;
}
function own(p, now) {
  p.updatedAt = now;
  p.touchedAt = now;
  return p;
}
function plan(pool, texts, now) {
  const p = clone(pool);
  const kept = p.tasks.filter((t) => t.status !== "pending" || t.children?.length || t.needsInput);
  const fresh = texts.map((text) => ({ id: nextId(p), text, status: "pending" }));
  p.tasks = [...kept, ...fresh];
  return own(p, now);
}
function addTask(pool, text, now) {
  const p = clone(pool);
  p.tasks.push({ id: nextId(p), text, status: "pending" });
  return own(p, now);
}
function setTitle(pool, title, now) {
  const p = clone(pool);
  p.title = title;
  return own(p, now);
}
function startTask(pool, id, now) {
  const p = clone(pool);
  const t = find(p, id);
  t.status = "in_progress";
  delete t.blockedReason;
  delete t.evidence;
  return own(p, now);
}
function blockTask(pool, id, reason, now) {
  const p = clone(pool);
  const t = find(p, id);
  t.status = "blocked";
  t.blockedReason = reason;
  delete t.evidence;
  return own(p, now);
}
function doneTask(pool, id, evidence, now) {
  const p = clone(pool);
  const t = find(p, id);
  t.status = "done";
  delete t.blockedReason;
  delete t.needsInput;
  if (evidence) t.evidence = evidence;
  else delete t.evidence;
  return own(p, now);
}
function askTask(pool, id, question, now) {
  const p = clone(pool);
  find(p, id).needsInput = question;
  return own(p, now);
}
function clearQuestions(pool, now, taskId) {
  if (!pool.tasks.some((t) => t.needsInput && (!taskId || t.id === taskId))) return void 0;
  const p = clone(pool);
  for (const t of p.tasks) if (!taskId || t.id === taskId) delete t.needsInput;
  p.updatedAt = now;
  return p;
}
function setParent(pool, parent, brief, now) {
  const p = clone(pool);
  const moved = p.parent?.sessionId !== parent.sessionId;
  p.parent = parent;
  if (brief) p.brief = brief;
  else if (moved) delete p.brief;
  p.updatedAt = now;
  return p;
}
function linkChild(pool, taskId, childId, now, byOwner = false) {
  const p = clone(pool);
  const t = find(p, taskId);
  t.children = [.../* @__PURE__ */ new Set([...t.children ?? [], childId])];
  if (t.status === "pending") t.status = "in_progress";
  if (byOwner) return own(p, now);
  p.updatedAt = now;
  return p;
}
function unlinkChild(pool, taskId, childId, now) {
  const p = clone(pool);
  const t = p.tasks.find((t2) => t2.id === taskId);
  if (t?.children) {
    t.children = t.children.filter((c) => c !== childId);
    if (!t.children.length) delete t.children;
  }
  p.updatedAt = now;
  return p;
}
function startTurn(pool, now) {
  const p = clone(pool);
  p.turnStartedAt = now;
  p.updatedAt = now;
  return p;
}

// src/out.ts
var ok = (stdout = "") => ({ code: 0, stdout, stderr: "" });

// src/prune.ts
import { existsSync as existsSync3, statSync as statSync2, unlinkSync, utimesSync, writeFileSync as writeFileSync2 } from "node:fs";
import { join as join4 } from "node:path";
var MAX_AGE_MS = 7 * DAY;
var EVERY_MS = 60 * 60 * 1e3;
var LOCK_WAIT_MS = 200;
var MAX_PER_RUN = 100;
var referencedIds = (ctx) => {
  const ids = /* @__PURE__ */ new Set();
  for (const e of listPools(ctx.orchHome)) {
    if (e.pool?.parent) ids.add(e.pool.parent.sessionId);
    for (const t of e.pool?.tasks ?? []) for (const c of t.children ?? []) ids.add(c);
  }
  return ids;
};
var stale = (pool, now) => !!pool && !pool.tasks.length && !pool.parent && now - Math.max(pool.updatedAt, pool.touchedAt ?? 0) >= MAX_AGE_MS;
var alive = (ctx, id) => readLiveSessions(ctx.claudeHome, ctx.isAlive).some((s) => s.sessionId === id);
async function pruneEmptyPools(ctx, keep) {
  const marker = join4(ctx.orchHome, ".pruned");
  const now = ctx.now();
  if (existsSync3(marker) && now - statSync2(marker).mtimeMs < EVERY_MS) return [];
  writeFileSync2(marker, "");
  utimesSync(marker, now / 1e3, now / 1e3);
  const pools = listPools(ctx.orchHome);
  const live2 = new Set(readLiveSessions(ctx.claudeHome, ctx.isAlive).map((s) => s.sessionId));
  const referenced = referencedIds(ctx);
  const removed = [];
  for (const { id, pool } of pools) {
    if (removed.length >= MAX_PER_RUN) break;
    if (id === keep || live2.has(id) || referenced.has(id) || !stale(pool, now)) continue;
    try {
      await withLock(
        ctx.orchHome,
        id,
        () => {
          if (!stale(readPool(ctx.orchHome, id), now) || alive(ctx, id)) return;
          unlinkSync(poolPath(ctx.orchHome, id));
          removed.push(id);
        },
        LOCK_WAIT_MS
      );
    } catch {
    }
  }
  return removed;
}

// src/hooks.ts
var WORK = /* @__PURE__ */ new Set(["Edit", "Write", "MultiEdit", "NotebookEdit", "Bash", "Agent", "Task"]);
var NO_POOL = '[orch] Your last turn changed files or ran commands, and this session has no task pool. If this is multi-step work, run `orch plan "step" "step" \u2026` (see the orch-pool skill).';
var STALE = "[orch] Your task pool was not updated during your last turn. Run `orch status`, then tick finished tasks with evidence or re-plan.";
var context = (event, text) => ok(`${JSON.stringify({ hookSpecificOutput: { hookEventName: event, additionalContext: text } })}
`);
var LOCK_WAIT_MS2 = 1500;
async function runHook(ctx, name) {
  try {
    const input = JSON.parse(await ctx.readStdin() || "{}");
    if (!input.session_id) return ok();
    if (name === "session-start") return await sessionStart(ctx, input);
    if (name === "prompt-submit") return await promptSubmit(ctx, input);
    log(ctx.orchHome, `unknown hook ${name}`);
  } catch (e) {
    log(ctx.orchHome, `hook ${name}: ${e instanceof OrchError ? e.message : e instanceof Error ? e.stack : String(e)}`);
  }
  return ok();
}
async function sessionStart(ctx, input) {
  const id = input.session_id;
  const now = ctx.now();
  poolPath(ctx.orchHome, id);
  const parentId = ctx.env.ORCH_PARENT;
  const taskId = ctx.env.ORCH_PARENT_TASK;
  const brief = ctx.env.ORCH_BRIEF;
  if (ctx.env.CLAUDE_ENV_FILE) {
    const unset = parentId || taskId || brief ? "unset ORCH_PARENT ORCH_PARENT_TASK ORCH_BRIEF\n" : "";
    appendFileSync2(ctx.env.CLAUDE_ENV_FILE, `export CLAUDE_SESSION_ID=${id}
${unset}`);
  }
  const linking = input.source === "startup" && !!(parentId && taskId);
  let linkable = false;
  if (linking) {
    try {
      linkable = !!readPool(ctx.orchHome, parentId)?.tasks.some((t) => t.id === taskId);
      if (!linkable) log(ctx.orchHome, `hook session-start: parent ${parentId} has no task ${taskId}; keeping only the brief`);
    } catch (e) {
      log(ctx.orchHome, `hook session-start: cannot use parent ${parentId}: ${e instanceof Error ? e.message : String(e)}`);
    }
  }
  const pool = await update(
    ctx.orchHome,
    id,
    (p) => {
      const q2 = p ?? newPool(id, input.cwd ?? ctx.cwd, now);
      if (!linking || q2.parent) return q2;
      if (linkable) return setParent(q2, { sessionId: parentId, taskId }, brief, now);
      return brief ? { ...q2, brief, updatedAt: now } : q2;
    },
    LOCK_WAIT_MS2
  );
  if (linkable && pool.parent?.sessionId === parentId && pool.parent?.taskId === taskId) {
    try {
      await updateIfExists(ctx.orchHome, parentId, (p) => linkChild(p, taskId, id, now), LOCK_WAIT_MS2);
    } catch (e) {
      log(ctx.orchHome, `hook session-start: cannot link ${id} under ${parentId}: ${e instanceof Error ? e.message : String(e)}`);
    }
  }
  try {
    await pruneEmptyPools(ctx, id);
  } catch (e) {
    log(ctx.orchHome, `hook session-start: prune: ${e instanceof Error ? e.message : String(e)}`);
  }
  if (!pool.brief) return ok();
  const next = pool.tasks.length ? "run `orch status` to pick up where you left off" : "then run `orch plan` for your part and tick each task with evidence";
  if (!pool.parent) return context("SessionStart", `[orch] Read ${pool.brief} first, ${next}.`);
  let parent;
  try {
    parent = readPool(ctx.orchHome, pool.parent.sessionId);
  } catch {
  }
  const task = parent?.tasks.find((t) => t.id === pool.parent.taskId);
  return context(
    "SessionStart",
    `[orch] This session is a child of "${oneLine(parent?.title) || pool.parent.sessionId}" for its task ${pool.parent.taskId}${task ? ` ("${oneLine(task.text)}")` : ""}. Read ${pool.brief} first, ${next}.`
  );
}
function clearAnswered(pool, prompt, now) {
  const frame = typeof prompt === "string" ? findFrame(prompt) : void 0;
  if (!frame) return clearQuestions(pool, now);
  const task = pool.tasks.find((t) => t.needsInput && frameQuestion(t.needsInput) === frame);
  return task ? clearQuestions(pool, now, task.id) : void 0;
}
async function promptSubmit(ctx, input) {
  const id = input.session_id;
  const now = ctx.now();
  const before = readPool(ctx.orchHome, id);
  const since = before?.turnStartedAt;
  await update(
    ctx.orchHome,
    id,
    (p) => {
      const q2 = p ?? newPool(id, input.cwd ?? ctx.cwd, now);
      return startTurn(clearAnswered(q2, input.prompt, now) ?? q2, now);
    },
    LOCK_WAIT_MS2
  );
  let didWork = false;
  if (since !== void 0 && input.transcript_path) {
    try {
      didWork = workedSince(input.transcript_path, since);
    } catch (e) {
      log(ctx.orchHome, `hook prompt-submit: cannot read transcript: ${e instanceof Error ? e.message : String(e)}`);
    }
  }
  if (!didWork || !before) return ok();
  if (!before.tasks.length) return context("UserPromptSubmit", NO_POOL);
  if ((before.touchedAt ?? 0) < since) return context("UserPromptSubmit", STALE);
  return ok();
}
function workedSince(path, since) {
  for (const line of readTail(path, 4 << 20).split("\n")) {
    if (!line.includes('"tool_use"')) continue;
    let o;
    try {
      o = JSON.parse(line);
    } catch {
      continue;
    }
    if (o.type !== "assistant" || !(Date.parse(o.timestamp ?? "") >= since)) continue;
    if (o.message?.content?.some((b) => b?.type === "tool_use" && WORK.has(b.name ?? ""))) return true;
  }
  return false;
}
function readTail(path, max) {
  const fd = openSync2(path, "r");
  try {
    const size = fstatSync(fd).size;
    const len = Math.min(size, max);
    const buf = Buffer.alloc(len);
    readSync(fd, buf, 0, len, size - len);
    return buf.toString("utf8");
  } finally {
    closeSync2(fd);
  }
}

// src/link.ts
var why = (e) => e instanceof Error ? e.message : String(e);
async function linkSessions(ctx, childId, parentId, taskId, opts = {}) {
  if (childId === parentId) throw new OrchError("a session cannot be its own parent");
  const parentOf = (id) => {
    try {
      return readPool(ctx.orchHome, id)?.parent?.sessionId;
    } catch {
      return void 0;
    }
  };
  for (let id = parentOf(parentId), n = 0; id && n < 64; id = parentOf(id), n++)
    if (id === childId) throw new OrchError("that parent sits below this session; linking it would make a cycle");
  if (!readPool(ctx.orchHome, parentId)?.tasks.some((t) => t.id === taskId)) throw new OrchError(`the parent has no task ${taskId}`);
  const now = ctx.now();
  let previous;
  try {
    previous = readPool(ctx.orchHome, childId)?.parent;
  } catch {
  }
  const cwd = readLiveSessions(ctx.claudeHome, ctx.isAlive).find((s) => s.sessionId === childId)?.cwd ?? "";
  try {
    const linked = await updateIfExists(ctx.orchHome, parentId, (p) => linkChild(p, taskId, childId, now, opts.byParent));
    if (!linked) throw new OrchError(`the parent has no pool`);
    await update(ctx.orchHome, childId, (p) => setParent(p ?? newPool(childId, cwd, now), { sessionId: parentId, taskId }, opts.brief, now));
  } catch (e) {
    throw new OrchError(`${why(e)}; rerun orch link`);
  }
  if (previous && (previous.sessionId !== parentId || previous.taskId !== taskId)) {
    try {
      await updateIfExists(ctx.orchHome, previous.sessionId, (p) => unlinkChild(p, previous.taskId, childId, now));
    } catch (e) {
      log(ctx.orchHome, `link: could not unlink ${childId} from ${previous.sessionId} ${previous.taskId}: ${why(e)}`);
    }
  }
}

// src/paths.ts
import { statSync as statSync3 } from "node:fs";
import { resolve } from "node:path";
function kind(path) {
  try {
    const s = statSync3(path);
    return s.isFile() ? "file" : s.isDirectory() ? "dir" : "other";
  } catch {
    return void 0;
  }
}
function briefFile(ctx, p) {
  const abs = resolve(ctx.cwd, p);
  const k = kind(abs);
  if (!k) throw new OrchError(`brief not found: ${abs}: write the brief first`);
  if (k !== "file") throw new OrchError(`brief is not a file: ${abs}`);
  return abs;
}
function workDir(ctx, p) {
  const abs = resolve(ctx.cwd, p);
  const k = kind(abs);
  if (!k) throw new OrchError(`cwd does not exist: ${abs}`);
  if (k !== "dir") throw new OrchError(`cwd is not a directory: ${abs}`);
  return abs;
}

// src/targets.ts
var NoMatch = class extends OrchError {
};
var live = (r) => r.state !== "ended";
var narrow = (rows) => {
  const l = rows.filter(live);
  return rows.length > 1 && l.length ? l : rows;
};
function resolveTarget(rows, query) {
  const all = flatten(rows).map((l) => l.row);
  const exact = narrow(all.filter((r) => r.sessionId === query || r.name === query));
  const matches = exact.length ? exact : narrow(all.filter((r) => query.length >= 6 && r.sessionId.startsWith(query) || r.title === query));
  if (matches.length === 1) return matches[0];
  if (!matches.length) throw new NoMatch(`no session matches "${query}"`);
  throw new OrchError(`"${query}" matches several sessions: ${matches.map((r) => `${r.name} (${r.sessionId.slice(0, 8)})`).join(", ")}`);
}
async function resolveSession(ctx, rows, query, opts = {}) {
  try {
    const r = resolveTarget(rows, query);
    return { sessionId: r.sessionId, name: r.name };
  } catch (e) {
    if (!(e instanceof NoMatch)) throw e;
    let pool;
    try {
      pool = readPool(ctx.orchHome, query);
    } catch {
    }
    if (pool) return { sessionId: query, name: safeLine(pool.title) || query };
    if (opts.herdr) {
      const agent = await ctx.herdr.list().then(
        (l) => l.find((a) => a.name === query),
        () => void 0
      );
      if (agent?.sessionId) return { sessionId: agent.sessionId, name: query };
      if (agent) throw new OrchError(`that session has no id yet; run orch status --all and link by its id`);
    }
    throw e;
  }
}

// src/reply.ts
var EXIT_SENDMESSAGE = 3;
var MAX_REPLY = 4e3;
var cleanText = (s) => s.replace(new RegExp("(?![\\n\\t])\\p{Cc}|\\p{Cf}", "gu"), "");
async function reply(ctx, query, text, markOnly, taskId) {
  const rows = await collect(ctx);
  const { sessionId, name } = await resolveSession(ctx, rows, query);
  const pool = readPool(ctx.orchHome, sessionId);
  const open = (pool?.tasks ?? []).filter((t) => t.needsInput);
  let task;
  if (taskId) {
    task = open.find((t) => t.id === taskId);
    if (!task) throw new OrchError(`${name} ${taskId} has no open question`);
  } else {
    if (!open.length) throw new OrchError(`${name} has no open question`);
    if (open.length > 1) throw new OrchError(`${name} has ${open.length} open questions (${open.map((t) => t.id).join(", ")}); pass --task <id>`);
    task = open[0];
  }
  const asked = task.needsInput;
  if (markOnly && text) throw new OrchError("--mark-only takes no reply text", 2);
  if (!markOnly) {
    const body = cleanText(text ?? "").trim();
    if (!body) throw new OrchError("missing reply text", 2);
    if (body.length > MAX_REPLY) throw new OrchError(`the reply is ${body.length} characters; the limit is ${MAX_REPLY}, shorten it`, 2);
    const row = flatten(rows).map((l) => l.row).find((r) => r.sessionId === sessionId);
    if (!row || row.state === "ended") throw new OrchError(`${name} has ended; its question stays open`);
    if (row.state === "waiting") throw new OrchError(`${name} is waiting on a dialog (${row.waitingFor}); answer that in the session first`);
    const frame = (t) => `${frameQuestion(asked)} ${t}`;
    if (!row.paneId) {
      const payload = { route: "sendmessage", sessionId, name, cwd: pool?.cwd ?? row.cwd, taskId: task.id, text: frame(body) };
      return { code: EXIT_SENDMESSAGE, stdout: `${JSON.stringify(payload)}
`, stderr: "" };
    }
    const message = frame(oneLine(body));
    const blocked = new OrchError(`${name} is waiting on a permission prompt; answer that in its pane first`);
    let state;
    try {
      state = await ctx.herdr.waitIdle(row.paneId, 9e4);
    } catch (e) {
      if (!(e instanceof HerdrError && e.herdrCode === "timeout")) throw e;
      throw new OrchError(`${name} is still busy after 90 s; its question stays open, try again later`);
    }
    if (state === "blocked") throw blocked;
    if (state !== "idle" && state !== "done") throw new OrchError(`${name} is ${state}; its question stays open, try again later`);
    if (readPool(ctx.orchHome, sessionId)?.tasks.find((t) => t.id === task.id)?.needsInput !== asked) {
      throw new OrchError(`${name} already answered that question in the session; nothing sent`);
    }
    try {
      await ctx.herdr.prompt(row.paneId, message);
    } catch (e) {
      if (e instanceof HerdrError && e.herdrCode === "agent_blocked") throw blocked;
      throw new OrchError(
        `${name} may not have got the reply (${e instanceof Error ? e.message : String(e)}); check its pane, then run orch reply ${sessionId} --task ${task.id} --mark-only if it arrived`
      );
    }
  }
  await updateIfExists(ctx.orchHome, sessionId, (p) => clearQuestions(p, ctx.now(), task.id) ?? p);
  return ok(`answered ${name} ${task.id}
`);
}

// src/self.ts
function resolveSelf(ctx) {
  const fromEnv = ctx.env.CLAUDE_CODE_SESSION_ID || ctx.env.CLAUDE_SESSION_ID;
  if (fromEnv) return fromEnv;
  const live2 = readLiveSessions(ctx.claudeHome, ctx.isAlive);
  const claudePid = Number(ctx.env.CLAUDE_PID);
  if (ctx.env.CLAUDE_PID && Number.isInteger(claudePid)) {
    const s = live2.find((x) => x.pid === claudePid);
    if (s) return s.sessionId;
  }
  const byPid = new Map(live2.map((s) => [s.pid, s.sessionId]));
  let pid = ctx.pid;
  for (let i = 0; i < 32 && pid && pid > 1; i++) {
    const id = byPid.get(pid);
    if (id) return id;
    pid = ctx.ppidOf(pid);
  }
  throw new OrchError("cannot tell which session this is: run orch from inside a Claude Code session");
}
function trySelf(ctx) {
  try {
    return resolveSelf(ctx);
  } catch {
    return void 0;
  }
}

// src/routing.ts
import { readFileSync as readFileSync4 } from "node:fs";
import { join as join5 } from "node:path";
var EFFORTS = ["low", "medium", "high", "xhigh", "max"];
var FALLBACK = { model: "opus", effort: "xhigh" };
function spawnDefaults(ctx) {
  try {
    const spawn2 = JSON.parse(readFileSync4(join5(ctx.claudeHome, "routing", "policy.json"), "utf8")).spawn ?? {};
    const str2 = (v, d) => typeof v === "string" && v ? v : d;
    return { model: str2(spawn2.model, FALLBACK.model), effort: str2(spawn2.effort, FALLBACK.effort) };
  } catch {
    return FALLBACK;
  }
}

// src/spawn.ts
var q = (s) => `'${s.replace(/'/g, `'\\''`)}'`;
var SESSION_ID_WAIT_MS = 6e4;
var POLL_MS = 500;
function agentName(base, taken) {
  const b = base.toLowerCase().replace(/[^a-z0-9_-]+/g, "-").replace(/^[^a-z]+/, "").slice(0, 28) || "child";
  let name = b;
  for (let i = 2; taken.includes(name); i++) name = `${b}-${i}`;
  return name;
}
var why2 = (e) => e instanceof Error ? e.message : String(e);
async function spawnChild(ctx, o) {
  const parentId = resolveSelf(ctx);
  const parent = readPool(ctx.orchHome, parentId);
  const task = parent?.tasks.find((t) => t.id === o.taskId);
  if (!parent || !task) throw new OrchError(`no task ${o.taskId} in this pool: run orch plan first`);
  const cwd = workDir(ctx, o.cwd);
  const brief = briefFile(ctx, o.brief);
  const defaults = spawnDefaults(ctx);
  const model = o.model || defaults.model;
  const effort = o.effort || defaults.effort;
  if (!EFFORTS.includes(effort)) throw new OrchError(`--effort must be one of ${EFFORTS.join(", ")}`);
  const runAs = ["--model", model, "--effort", effort];
  const intro = `You are a child session of "${oneLine(parent.title) || parentId}", working on its task ${task.id}: "${oneLine(task.text)}". Read ${brief} first, then run \`orch plan\` for your part and tick each task with evidence.` + (o.prompt ? `

${o.prompt}` : "");
  const shown = oneLine(intro);
  if (ctx.env.HERDR_ENV !== "1" || !ctx.env.HERDR_WORKSPACE_ID) {
    const name2 = agentName(o.name, []);
    const cmd = `cd ${q(oneLine(cwd))} && ORCH_PARENT=${parentId} ORCH_PARENT_TASK=${task.id} ORCH_BRIEF=${q(oneLine(brief))} claude --remote-control=${q(name2)} --model ${q(model)} --effort ${q(effort)} ${q(shown)}`;
    return ok(`Not inside herdr. Start the child yourself:
${cmd}
`);
  }
  const name = agentName(o.name, (await ctx.herdr.list()).map((a) => a.name));
  const { paneId } = await ctx.herdr.createTab({ workspace: ctx.env.HERDR_WORKSPACE_ID, cwd, label: name });
  const linkCmd = (who) => `orch link ${who} ${parentId} ${task.id} --brief ${q(oneLine(brief))}`;
  const promptCmd = (target) => `herdr agent prompt ${target} ${q(shown)}`;
  const noId = `If that says the session has no id yet, run orch status --all and link by its id.`;
  try {
    await ctx.herdr.startClaude({ name, paneId, args: ["--remote-control", name, ...runAs] });
  } catch (e) {
    const trust = e instanceof HerdrError && e.herdrCode === "agent_not_ready";
    throw new OrchError(
      `${name} did not become ready in ${paneId} (${why2(e)}). ` + (trust ? `If that pane asks "Do you trust this folder?", ${cwd} has never been opened in Claude: answer it there. ` : "") + `Once it runs, link it: ${linkCmd(name)} ; then send its intro: ${promptCmd(paneId)} . ${noId}`
    );
  }
  let childId;
  const deadline = ctx.now() + SESSION_ID_WAIT_MS;
  for (; ; ) {
    childId = await ctx.herdr.sessionIdOf(name);
    if (childId || ctx.now() >= deadline) break;
    await ctx.sleep(POLL_MS);
  }
  if (!childId)
    throw new OrchError(
      `started ${name} in ${paneId} but herdr did not report its session id within ${SESSION_ID_WAIT_MS / 1e3}s. Link it later: ${linkCmd(name)} ; then send its intro: ${promptCmd(name)} . ${noId}`
    );
  try {
    await linkSessions(ctx, childId, parentId, task.id, { brief, byParent: true });
  } catch (e) {
    throw new OrchError(`${name} runs in ${paneId} (session ${childId}) but linking failed: ${why2(e)}. Link it: ${linkCmd(q(childId))} ; then send its intro: ${promptCmd(name)}`);
  }
  try {
    await ctx.herdr.prompt(name, shown);
  } catch (e) {
    throw new OrchError(`${name} is linked under ${parentId} ${task.id}, but sending its intro failed (${why2(e)}). Send it yourself: ${promptCmd(name)}`);
  }
  return ok(`${JSON.stringify({ sessionId: childId, agent: name, paneId })}
`);
}

// src/cli.ts
var HELP = `orch \u2014 task pools for Claude Code sessions

  orch plan "step" "step" \u2026              replace the pending part of this session's pool
  orch title "what this session is for"
  orch task add "text"
  orch task start <id>
  orch task block <id> "why"
  orch task done <id> [--evidence commit:<sha> | pr:<n|url> | ci:<run-url> | cmd:<command> | note:<text>]
  orch ask <id> "question"               flag a question for the person (\u2691)
  orch status [<session-id>] [--json]    this (or that) session's pool
  orch status --all [--json]             every session
  orch link <child> <parent> <taskId> [--brief <file>]
                                         attach a session under a parent task
  orch spawn-child <taskId> --name <n> --cwd <dir> --brief <file> [--prompt <text>] [--model <m>] [--effort <level>]
  orch reply <session> [--task <id>] -- "text"
                                         answer a session's open question (the -- keeps a text that starts with a dash)
  orch reply <session> [--task <id>] --mark-only
                                         mark it answered after delivering the text yourself
  orch tui
`;
var need = (v, what) => {
  if (!v) throw new OrchError(`missing ${what} (orch help lists the commands)`, 2);
  return v;
};
var words = (args) => parseArgs({ args, allowPositionals: true }).positionals;
function mutateSelf(ctx, f) {
  const id = resolveSelf(ctx);
  return update(ctx.orchHome, id, (p) => f(p ?? newPool(id, ctx.cwd, ctx.now())));
}
function poolText(ctx, p) {
  const rows = buildOverview({ pools: listPools(ctx.orchHome), live: [], agents: null, checks: /* @__PURE__ */ new Map(), now: ctx.now() });
  const row = flatten(rows).map((l) => l.row).find((r) => r.sessionId === p.sessionId);
  return row ? renderPool(row) : "";
}
async function cmdPlan(ctx, args) {
  const steps = words(args).map((s) => s.trim());
  if (!steps.length) throw new OrchError("orch plan needs at least one step", 2);
  if (steps.some((s) => !s)) throw new OrchError("orch plan steps cannot be blank", 2);
  const p = await mutateSelf(ctx, (p2) => plan(p2, steps, ctx.now()));
  return ok(poolText(ctx, p));
}
async function cmdTitle(ctx, args) {
  const title = need(words(args).join(" ").trim() || void 0, "title");
  await mutateSelf(ctx, (p) => setTitle(p, title, ctx.now()));
  return ok(`title: ${title}
`);
}
function tailOf(out) {
  const clean = stripEscapes(out).replace(/\r\n?/g, "\n").replace(new RegExp("\\p{Cc}", "gu"), (c) => c === "\n" || c === "	" ? c : "").trimEnd().split("\n").slice(-20).join("\n");
  return clean.length > 4096 ? `\u2026${clean.slice(-4096)}` : clean;
}
function refusal(message, out) {
  const tail = tailOf(out);
  return new OrchError(tail ? `${message}
${tail}` : message);
}
async function cmdDone(ctx, args) {
  const { values, positionals } = parseArgs({ args, options: { evidence: { type: "string" } }, allowPositionals: true });
  const id = need(positionals[0], "task id");
  if (positionals.length > 1) throw new OrchError(`orch task done takes one task id, got "${positionals.join(" ")}"; quote the evidence, e.g. --evidence "note:looked fine"`, 2);
  let evidence;
  let unsettled;
  if (values.evidence !== void 0) {
    const e = parseEvidence(values.evidence);
    if (e.kind === "cmd") {
      const self = readPool(ctx.orchHome, resolveSelf(ctx));
      if (!self?.tasks.some((t) => t.id === id)) throw new OrchError(`no task ${id} in this pool`);
      const r = await ctx.exec(e.ref, ctx.cwd);
      if (r.timedOut) {
        throw refusal(`refused: \`${e.ref}\` timed out after ${CMD_TIMEOUT_MS / 1e3} s in ${ctx.cwd}, so ${id} stays open; run long commands yourself and tick with commit:, ci: or note:`, r.out);
      }
      if (r.signal || r.code !== 0) {
        const how = r.signal ? `was killed by ${r.signal}` : `exited ${r.code}`;
        throw refusal(`refused: \`${e.ref}\` ${how} in ${ctx.cwd}, so ${id} stays open`, r.out);
      }
      evidence = { kind: "cmd", ref: e.ref, exit: 0 };
    } else {
      evidence = e;
      if (e.kind === "ci" || e.kind === "pr") {
        const self = readPool(ctx.orchHome, resolveSelf(ctx));
        if (!self?.tasks.some((t) => t.id === id)) throw new OrchError(`no task ${id} in this pool`);
        const verdict = await ctx.gh.check(e, self.cwd || ctx.cwd);
        if (verdict === "fail") throw new OrchError(`refused: ${describeEvidence(e)} is failing, so ${id} stays open`);
        if (verdict !== "pass") unsettled = `${id} done; ${describeEvidence(e)} is ${verdict}, orch will keep checking it
`;
      }
    }
  }
  await mutateSelf(ctx, (p) => doneTask(p, id, evidence, ctx.now()));
  if (unsettled) return ok(unsettled);
  const where = evidence?.kind === "cmd" ? ` in ${ctx.cwd}` : "";
  return ok(evidence ? `${id} done (${describeEvidence(evidence)}${where})
` : `${id} done, but only claimed: add --evidence to prove it
`);
}
async function cmdTask(ctx, args) {
  const [sub, ...rest] = args;
  const now = ctx.now();
  switch (sub) {
    case "add": {
      const text = need(words(rest).join(" ").trim() || void 0, "task text");
      const p = await mutateSelf(ctx, (p2) => addTask(p2, text, now));
      return ok(`added ${p.tasks.at(-1).id}
`);
    }
    case "start": {
      const id = need(words(rest)[0], "task id");
      await mutateSelf(ctx, (p) => startTask(p, id, now));
      return ok(`${id} in progress
`);
    }
    case "block": {
      const [id, ...reason] = words(rest);
      need(id, "task id");
      const why3 = need(reason.join(" ").trim() || void 0, "reason");
      await mutateSelf(ctx, (p) => blockTask(p, id, why3, now));
      return ok(`${id} blocked: ${why3}
`);
    }
    case "done":
      return cmdDone(ctx, rest);
    default:
      throw new OrchError(`usage: orch task add|start|block|done \u2026

${HELP}`, 2);
  }
}
async function cmdAsk(ctx, args) {
  const [id, ...rest] = words(args);
  need(id, "task id");
  const question = need(rest.join(" ").trim() || void 0, "question");
  await mutateSelf(ctx, (p) => askTask(p, id, question, ctx.now()));
  return ok(`\u2691 ${id}: ${question}
Now send the person a push notification naming this session and the question.
`);
}
async function cmdStatus(ctx, args) {
  const { values, positionals } = parseArgs({ args, options: { all: { type: "boolean" }, json: { type: "boolean" } }, allowPositionals: true });
  if (values.all) {
    const rows2 = await collect(ctx);
    return ok(values.json ? `${JSON.stringify(rows2, (k, v) => k === "tasks" ? void 0 : v)}
` : renderList(rows2));
  }
  const id = positionals[0] ?? resolveSelf(ctx);
  const rows = await collect(ctx, { checks: /* @__PURE__ */ new Set([id]) });
  const row = flatten(rows).map((l) => l.row).find((r) => r.sessionId === id);
  if (positionals[0] && !row) throw new OrchError(`no session ${id}`);
  if (values.json) return ok(`${JSON.stringify(row ?? null)}
`);
  if (row?.tasks.length) return ok(renderPool(row));
  return ok(row && positionals[0] ? `${row.name} has no pool yet
` : 'no pool yet: run orch plan "step" "step" \u2026\n');
}
function describeFailure(e) {
  const message = e instanceof Error ? e.message : String(e);
  const code = e?.code;
  const sandbox = code === "EACCES" || code === "EPERM" || code === "EROFS";
  return `orch: ${message}
${sandbox ? `if Claude Code's Bash sandbox is on, add "orch *" to sandbox.excludedCommands in ~/.claude/settings.json
` : ""}`;
}
async function cmdLink(ctx, args) {
  const { values, positionals } = parseArgs({ args, options: { brief: { type: "string" } }, allowPositionals: true });
  const [child, parent, taskId] = [need(positionals[0], "child session"), need(positionals[1], "parent session"), need(positionals[2], "parent task id")];
  const brief = values.brief === void 0 ? void 0 : briefFile(ctx, values.brief);
  const rows = await collect(ctx);
  const c = await resolveSession(ctx, rows, child, { herdr: true });
  const p = await resolveSession(ctx, rows, parent);
  await linkSessions(ctx, c.sessionId, p.sessionId, taskId, { brief, byParent: trySelf(ctx) === p.sessionId });
  return ok(`${c.name} is now under ${p.name} ${taskId}
`);
}
async function cmdSpawn(ctx, args) {
  const { values, positionals } = parseArgs({
    args,
    options: { name: { type: "string" }, cwd: { type: "string" }, brief: { type: "string" }, prompt: { type: "string" }, model: { type: "string" }, effort: { type: "string" } },
    allowPositionals: true
  });
  return spawnChild(ctx, {
    taskId: need(positionals[0], "task id"),
    name: need(values.name, "--name"),
    cwd: need(values.cwd, "--cwd"),
    brief: need(values.brief, "--brief"),
    prompt: values.prompt,
    model: values.model,
    effort: values.effort
  });
}
async function cmdReply(ctx, args) {
  const { values, positionals } = parseArgs({
    args,
    options: { "mark-only": { type: "boolean" }, task: { type: "string" } },
    allowPositionals: true
  });
  const session = need(positionals[0], "session");
  return reply(ctx, session, positionals.slice(1).join(" ").trim() || void 0, !!values["mark-only"], values.task);
}
async function run(argv2, ctx) {
  const [cmd, ...rest] = argv2;
  const flags = rest.includes("--") ? rest.slice(0, rest.indexOf("--")) : rest;
  if (flags.includes("--help") || flags.includes("-h")) return ok(HELP);
  try {
    switch (cmd) {
      case "plan":
        return await cmdPlan(ctx, rest);
      case "title":
        return await cmdTitle(ctx, rest);
      case "task":
        return await cmdTask(ctx, rest);
      case "ask":
        return await cmdAsk(ctx, rest);
      case "status":
        return await cmdStatus(ctx, rest);
      case "hook":
        return await runHook(ctx, rest[0]);
      case "link":
        return await cmdLink(ctx, rest);
      case "spawn-child":
        return await cmdSpawn(ctx, rest);
      case "reply":
        return await cmdReply(ctx, rest);
      case void 0:
      case "help":
      case "--help":
      case "-h":
        return ok(HELP);
      default:
        return { code: 2, stdout: "", stderr: `orch: unknown command ${cmd}

${HELP}` };
    }
  } catch (e) {
    if (e instanceof OrchError) return { code: e.code, stdout: "", stderr: `orch: ${e.message}
` };
    if (e instanceof TypeError && e.code?.startsWith("ERR_PARSE_ARGS")) return { code: 2, stdout: "", stderr: `orch: ${e.message}
` };
    throw e;
  }
}

// src/main.ts
var argv = process.argv.slice(2);
try {
  if (argv[0] === "tui" && !argv.some((a) => a === "--help" || a === "-h")) {
    const tui = new URL("../lib/orch-tui.mjs", import.meta.url).href;
    const { startTui } = await import(tui);
    await startTui(realCtx());
  } else {
    const out = await run(argv, realCtx());
    process.stdout.write(out.stdout);
    process.stderr.write(out.stderr);
    process.exitCode = out.code;
  }
} catch (e) {
  process.stderr.write(describeFailure(e));
  process.exitCode = 1;
}
